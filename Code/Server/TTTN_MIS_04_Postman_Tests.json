          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200 OK', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Không chứa bản nháp', function () {",
