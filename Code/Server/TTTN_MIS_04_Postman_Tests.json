                  "pm.collectionVariables.set('test_workshop_id', jsonData.workshop_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03.2: Tạo Workshop với start_at >= end_at => Lỗi validate (422 Unprocessable)",
