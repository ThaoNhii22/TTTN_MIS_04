              "mode": "raw",
              "raw": "{\"title\": \"L\\u1ed7i Th\\u1eddi Gian\", \"location\": \"Ph\\u00f2ng A\", \"quota\": 20, \"start_at\": \"2026-12-01T11:00:00\", \"end_at\": \"2026-12-01T09:00:00\", \"checkin_start_at\": \"2026-12-01T08:00:00\", \"checkin_end_at\": \"2026-12-01T09:00:00\"}"
            },
            "url": "{{base_url}}/workshops"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 422 hoặc 400', function () { pm.expect(pm.response.code).to.be.oneOf([422, 400]); });"
                ]
              }
