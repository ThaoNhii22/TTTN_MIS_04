            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Workshop Automation Testing Postman {{$timestamp}}\", \"description\": \"Workshop ki\\u1ec3m th\\u1eed API t\\u1ef1 \\u0111\\u1ed9ng theo chu\\u1ea9n \\u0111\\u1eb7c t\\u1ea3\", \"location\": \"H\\u1ed9i tr\\u01b0\\u1eddng B, T\\u00f2a nh\\u00e0 Trung t\\u00e2m\", \"quota\": 30, \"start_at\": \"2026-12-01T09:00:00\", \"end_at\": \"2026-12-01T11:30:00\", \"registration_open_at\": \"2026-11-15T00:00:00\", \"registration_close_at\": \"2026-11-30T23:59:00\", \"checkin_start_at\": \"2026-12-01T08:30:00\", \"checkin_end_at\": \"2026-12-01T09:30:00\"}"
